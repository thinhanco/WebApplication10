@{
    Layout = "_AdminDashboardLayout";
    ViewData["Title"] = "Dashboard Quản Trị";
}

@section Styles {
    <style>
        /* 1. MÀU SẮC CHỦ ĐẠO THEO HOTEL VIP TRONG ẢNH */
        :root {
            --primary-gold: #d4af37; /* Màu vàng từ nút "Cấp tài khoản mới" */
            --dark-blue: #2c3e50;    /* Màu xanh than từ sidebar */
            --light-bg: #f4f7f6;
        }

        /* 2. FONT CHỮ TIÊU ĐỀ SANG TRỌNG (SERIF) */
        h1, h3 {
            font-family: 'Playfair Display', serif; /* Font chữ giống logo Hotel VIP */
            color: var(--dark-blue);
        }

        /* 3. TỐI ƯU HEADER DASHBOARD */
        .admin-header {
            background: #fff; /* Đổi thành nền trắng cho sang giống trang Account */
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            border-left: 5px solid var(--primary-gold); /* Nhấn nhá vạch vàng */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-header-text h1 {
            font-size: 2.2rem;
            margin: 0;
            font-weight: 700;
        }

        /* 4. STAT CARDS (Các ô chỉ số nhanh) */
        .admin-quick-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .quick-stat-item {
            background: #fff;
            padding: 15px 25px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #eee;
            transition: 0.3s;
        }
        
        .quick-stat-item:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }

        .quick-stat-item span {
            display: block;
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary-gold);
        }

        .quick-stat-item small {
            color: #777;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 1px;
        }

        /* 5. KHUNG BIỂU ĐỒ (Giống Card trong trang Account) */
        .dashboard-main-content {
            background: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 25px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }

        .chart-header {
            border-bottom: 1px solid #eee;
            padding-bottom: 15px;
            margin-bottom: 25px;
        }

        /* 6. LỐI TẮT (Khớp với Sidebar trong ảnh) */
        .quick-actions-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .action-link-card {
            background: #fff;
            padding: 20px;
            border-radius: 12px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 15px;
            border: 1px solid #eee;
            transition: 0.3s;
        }

        .action-link-card:hover {
            border-color: var(--primary-gold);
            background: #fffaf0;
        }

        .action-link-card i { color: var(--primary-gold); font-size: 1.2rem; }
        .action-link-card span { color: var(--dark-blue); font-weight: 600; }
    </style>
}

<!-- 1. HEADER CHÀO MỪNG -->
<div class="admin-header">
    <div class="admin-header-text">
        <h1>Dashboard Tổng Quan</h1>
        <p class="text-muted">Hệ thống quản lý khách sạn Hotel VIP</p>
    </div>
    
    <div class="admin-quick-stats">
        <div class="quick-stat-item">
            <span>@ViewBag.TotalStaff</span>
            <small>Nhân viên</small>
        </div>
        <div class="quick-stat-item">
            <span>@ViewBag.TotalRooms</span>
            <small>Phòng</small>
        </div>
        <div class="quick-stat-item">
            <span style="color: #27ae60">@ViewBag.MonthlyRevenue</span>
            <small>Doanh thu tháng</small>
        </div>
        <div class="quick-stat-item">
            <span>@ViewBag.PendingShifts</span>
            <small>Ca chờ duyệt</small>
        </div>
    </div>
</div>

<!-- 2. BIỂU ĐỒ CHÍNH -->
<div class="dashboard-main-content">
    <div class="chart-header d-flex justify-content-between align-items-center">
        <h3><i class="fas fa-chart-line me-2" style="color: var(--primary-gold)"></i> Doanh Thu 7 Ngày Gần Nhất</h3>
        <span class="badge rounded-pill bg-light text-dark border">Live Data</span>
    </div>
    
    <div style="height: 350px; width: 100%;">
        <canvas id="myChart"></canvas>
    </div>
</div>

<!-- 3. LỐI TẮT QUẢN LÝ (Khớp với Sidebar ảnh 1) -->
<div class="quick-actions-bar">
    <a asp-action="QuanLyTaiKhoan" class="action-link-card">
        <i class="fas fa-users-cog"></i>
        <span>Quản Lý Tài Khoản</span>
    </a>
    <a asp-action="QuanLyNhanVien" class="action-link-card">
        <i class="fas fa-user-tie"></i>
        <span>Quản Lý Nhân Viên</span>
    </a>
    <a asp-action="QuanLyHeThong" class="action-link-card">
        <i class="fas fa-hotel"></i>
        <span>Cấu Hình Hệ Thống</span>
    </a>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var labelsData = @Html.Raw(ViewBag.ChartLabels ?? "[]"); 
            var revenueData = @Html.Raw(ViewBag.ChartData ?? "[]");  

            var ctx = document.getElementById('myChart').getContext('2d');
            
            // Tạo Gradient cho đẹp (nhạt dần xuống dưới)
            var gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(212, 175, 55, 0.4)');
            gradient.addColorStop(1, 'rgba(212, 175, 55, 0)');

            new Chart(ctx, {
                type: 'line', 
                data: {
                    labels: labelsData,
                    datasets: [{
                        label: 'Doanh thu',
                        data: revenueData,
                        borderColor: '#d4af37',
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#d4af37',
                        pointBorderWidth: 2,
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            suggestedMax: 10000000,
                            ticks: {
                                callback: (v) => new Intl.NumberFormat('vi-VN').format(v) + ' đ'
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#2c3e50',
                            padding: 10,
                            callbacks: {
                                label: (c) => 'Doanh thu: ' + new Intl.NumberFormat('vi-VN').format(c.parsed.y) + ' VNĐ'
                            }
                        }
                    }
                }
            });
        });
    </script>
}
